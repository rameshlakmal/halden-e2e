# Where the Halden Outfitters repo is checked out (https://github.com/rameshlakmal/halden-outfitters).
# The runner starts its dev server and resets its database from there.
HALDEN_SHOP_DIR=../../sql/halden-shop

# A database used only by these tests, never the live demo's. `npm run db:create` creates it.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/halden_e2e

# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Passwords the shop's seed script gives the demo accounts (8+ characters each).
SEED_ADMIN_PASSWORD=
SEED_SHOPPER_PASSWORD=

# The model behind every agent step, through OpenRouter.
OPENROUTER_API_KEY=
# Optional overrides (OpenRouter model ids). Defaults: a fast model for tests, a stronger one for exploring.
HALDEN_MODEL=
HALDEN_EXPLORE_MODEL=

# Planted bugs to switch on before every test, comma-separated, e.g. coupon_twice,payment_misses_shipping.
# Empty means a healthy shop. Keys: coupon_twice, cancel_keeps_stock, payment_misses_shipping,
# price_edit_rewrites_orders, coupon_limit_ignored.
HALDEN_BUGS=

# 1 = after every test, run the shop's business rules (qa/rules.sql) and fail the test on any broken rule.
HALDEN_DB_RULES=
