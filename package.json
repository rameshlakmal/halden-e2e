{
  "name": "halden-e2e",
  "version": "0.1.0",
  "description": "Agentic end-to-end tests for Halden Outfitters, built with TesterArmy e2e: hybrid tests, replay cache, project tools and a bug bash against planted bugs.",
  "scripts": {
    "db:create": "node scripts/db-create.ts",
    "test:e2e": "e2e run",
    "test:smoke": "e2e run --tag smoke",
    "test:db": "node scripts/with-env.ts HALDEN_DB_RULES=1 -- e2e run",
    "bug-matrix": "node scripts/bug-matrix.ts",
    "typecheck": "tsc --noEmit",
    "bugbash": "node scripts/bugbash.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@e2e-dev/github": "0.4.0",
    "@e2e-dev/web": "0.13.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.131",
    "e2e": "0.18.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.8"
  }
}
